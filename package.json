{
  "name": "promold-app",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "prettier --check \"**/*.{ts,tsx,json}\"",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:verify": "./scripts/verify-schema.sh && node scripts/check-db-calls.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,json}\"",
    "db:check-calls": "node scripts/check-db-calls.mjs"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "prettier": "^3.4.2"
  }
}
