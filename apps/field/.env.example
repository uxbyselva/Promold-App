# Copy to .env.local. Both values are safe to publish: the publishable key can
# only do what row-level security lets the signed-in user do.
#
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Never put a service_role or sb_secret_ key here. It would be compiled into
# the browser bundle and would bypass every policy in the database.
