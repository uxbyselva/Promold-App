# Copy to .env.local and fill in from Supabase → Project Settings → API.
# .env.local is gitignored. Never commit real values.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# "anon public". Safe in a browser bundle — row-level security is what
# protects the data, and this key gets no more than the signed-in user has.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# The service_role key is deliberately NOT listed here.
#
# It bypasses row-level security completely: every table, every row, no
# permission checks. It belongs only in a server-side secret store, never in
# a NEXT_PUBLIC_ variable, never in a file under version control, and never
# pasted into a chat or an issue. Nothing in this app needs it.
